# -----------------------------------------------------------------------------
# .env.redshift_extractor - copia este archivo con ese nombre y llena los valores.
#
# Esta libreria lee UNICAMENTE este archivo. Nunca lee el .env del proyecto host y
# nunca escribe en el entorno del proceso.
#
# Guardalo en UTF-8 SIN BOM. PowerShell 5.1 (Set-Content, >, Out-File) agrega BOM y
# la carga trueana con un mensaje que explica como quitarlo.
# -----------------------------------------------------------------------------

# SSH (bastion)
SSH_HOST=your.ssh.host
SSH_PORT=22
SSH_USER=ec2-user
SSH_PKEY_PATH=/absolute/path/to/key.pem

# Verificacion de la host key del bastion. La verificacion NO se puede desactivar.
# Por default se usa ~/.ssh/known_hosts; con SSH_HOST_FINGERPRINT se verifica contra
# el hash y known_hosts se ignora, que es mas fuerte porque el fingerprint lo
# verificaste fuera de banda en vez de confiar en lo que conteste el host.
# Para ver el que presenta el servidor: redshift-extractor fingerprint
# SSH_KNOWN_HOSTS_PATH=/absolute/path/to/known_hosts
# SSH_HOST_FINGERPRINT=SHA256:reemplaza-esto-con-el-fingerprint-real

# Puerto local del tunel. 0 = efimero (recomendado): un puerto fijo colisiona con
# otra libreria del ecosistema o con otro proceso tuyo.
SSH_LOCAL_PORT=0
# SSH_CONNECT_TIMEOUT_S=15
# SSH_KEEPALIVE_S=30
# SSH_COMPRESSION=false

# App
# LOG_LEVEL solo se lee de ESTE archivo. Para pisarlo desde el entorno del proceso
# la variable lleva prefijo propio: REDSHIFT_EXTRACTOR_LOG_LEVEL.
LOG_LEVEL=INFO
OUTPUT_DIR=./output

# Alias que se usa cuando no se pasa `alias=` (E2 del estandar del ecosistema).
DEFAULT_ALIAS=prod

# Redshift connections (multi)
# Use REDSHIFT__<ALIAS>__<FIELD>
# Required per alias: HOST, PORT, DBNAME
#
# Credentials: elige UNA de las dos opciones por alias.
#
# Opcion A (recomendada) - apuntar a una variable de sistema con CREDENTIALS_ENV.
# La variable debe resolver a user/password en alguno de estos formatos:
#   {"user":"db_user","password":"db_password"}
#   USER=db_user;PASSWORD=db_password
#   db_user:db_password
REDSHIFT__prod__HOST=your-prod-cluster.xxxxxx.region.redshift.amazonaws.com
REDSHIFT__prod__PORT=5439
REDSHIFT__prod__DBNAME=analytics
REDSHIFT__prod__CREDENTIALS_ENV=REDSHIFT_PROD_CREDENTIALS

# Opcion B (solo uso local) - credenciales inline con USER/PASSWORD.
# Omite CREDENTIALS_ENV; si lo defines, tiene prioridad sobre USER/PASSWORD.
REDSHIFT__dev__HOST=your-dev-cluster.xxxxxx.region.redshift.amazonaws.com
REDSHIFT__dev__PORT=5439
REDSHIFT__dev__DBNAME=analytics_dev
REDSHIFT__dev__USER=db_user
REDSHIFT__dev__PASSWORD=db_password
